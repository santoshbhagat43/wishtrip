{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "gen:api": "cd ../backend && uv run python -m app.scripts.export_openapi ../website/src/lib/api/openapi.json && cd ../website && openapi-typescript src/lib/api/openapi.json -o src/lib/api/schema.d.ts",
    "test:e2e": "playwright test --grep-invert \"@conversations|@demo\"",
    "test:e2e:headless": "HEADLESS=1 playwright test --grep-invert \"@conversations|@demo\"",
    "test:report": "playwright show-report",
    "test:conversations": "playwright test --grep @conversations",
    "test:demo": "playwright test --grep @demo",
    "test:demo:headless": "HEADLESS=1 playwright test --grep @demo",
    "test:knowledge": "playwright test --grep @knowledge",
    "test:knowledge:headless": "HEADLESS=1 playwright test --grep @knowledge"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.53.0",
    "next": "16.3.8",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.17.0"
}
