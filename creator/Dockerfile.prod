# Production image: built once, served by `next start` (the plain Dockerfile is for `next dev`).
FROM node:24-alpine AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
# Rewrites (e.g. /media → backend) are resolved at build time, so the backend URL is a build arg.
ARG BACKEND_URL=http://backend:8000
# The traveller website creators' links point at (NEXT_PUBLIC_ values are fixed at build time).
ARG NEXT_PUBLIC_WEBSITE_URL=https://wishtrip.listnr.co
ENV BACKEND_URL=$BACKEND_URL NEXT_PUBLIC_WEBSITE_URL=$NEXT_PUBLIC_WEBSITE_URL NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production
# Build with webpack: Next 16's default (Turbopack) fails to resolve next/font/google in a
# production build (@vercel/turbopack-next/internal/font/google/font). webpack is stable here.
RUN pnpm build --webpack

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app ./
EXPOSE 3000
# Run next directly: no pnpm/corepack, so nothing is downloaded when the container starts.
CMD ["node_modules/.bin/next", "start", "--hostname", "0.0.0.0", "--port", "3000"]
