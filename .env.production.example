# Production settings for docker-compose.prod.yml. Copy to .env.production on the server.
# deploy/deploy.sh fills in the generated secrets on first run; OPENROUTER_API_KEY is yours to add.

# Domains (DNS A records must point at the server).
WEBSITE_DOMAIN=wishtrip.listnr.co
CREATOR_DOMAIN=creator.listnr.co
DASHBOARD_DOMAIN=wishtrip-dashboard.listnr.co
SSO_DOMAIN=sso.listnr.co
API_DOMAIN=wishtrip-api.listnr.co

ENVIRONMENT=production

# Single sign-on. One session cookie shared across every app under the parent domain, minted
# only by the SSO app. On the final domain this becomes .wishtrip.co / https://sso.wishtrip.co.
SESSION_COOKIE_DOMAIN=.listnr.co
SSO_URL=https://sso.listnr.co
POST_LOGIN_FALLBACK_URL=https://wishtrip.listnr.co/

# Google sign-in. Create an OAuth client in Google Cloud; register the redirect URI
# https://sso.listnr.co/api/sso/google/callback. The client_id is passed to the dashboard/SSO
# container; the secret stays backend-only. Until both are set, the Google button is inert.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SaveAPI (api.saveapi.org): the paid fallback when our own download of an Instagram reel or a
# YouTube video fails (Instagram wants a fresh login; YouTube refuses most server addresses).
# Roughly 1.5 credits per Instagram reel and 12 per YouTube video, only ever spent after our own
# download has failed, and every attempt is recorded (GET /reels/downloads, admin only). Leave
# empty for no fallback.
SAVEAPI_KEY=

# Creator sign-in codes, by email, sent through Trustsignal (https://trustsignal.io). In the
# Trustsignal account: create an OTP email template with a {{otp}} variable, and verify the sender
# address. Email is live once the key, sender and template are all set. WhatsApp codes (also
# Trustsignal) are not wired yet, so creators sign in by email for now.
TRUSTSIGNAL_API_KEY=
TRUSTSIGNAL_EMAIL_FROM=login@wishtrip.co
TRUSTSIGNAL_EMAIL_TEMPLATE_ID=
# The template variable that holds the code (default: otp, i.e. {{otp}} in the template).
# TRUSTSIGNAL_OTP_VARIABLE=otp
# TRUSTSIGNAL_EMAIL_SUBJECT=Your WishTrip sign-in code
# Until all three are set, NO sign-in code is sent and creators see "We can't send sign-in codes
# right now". There is no fixed fallback code any more.

# SMTP still works as a second email provider (used only when Trustsignal is not configured).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=WishTrip <login@wishtrip.co>

# HARDCODED FIXED SIGN-IN CODE: REMOVED. It used to be CREATOR_DEV_OTP=1234, which let anyone who
# knew a creator's email sign in as them. Do not set it here: the app ignores it when
# ENVIRONMENT=production anyway.
# CREATOR_DEV_OTP=1234

# Private preview login for the traveler website (/gate). deploy/deploy.sh generates the
# password when empty. The gate stays on in production until launch day sets SITE_PUBLIC=true.
SITE_USER=wishtrip
SITE_PASSWORD=
SITE_PUBLIC=false

# Secrets — generated by deploy/deploy.sh when empty.
POSTGRES_PASSWORD=
JWT_SECRET=

# Browsers that may call the API directly (the two apps proxy server-side, so this is for
# the API docs and future clients).
CORS_ORIGINS=["https://wishtrip.listnr.co","https://creator.listnr.co","https://wishtrip-dashboard.listnr.co","https://sso.listnr.co"]

# AI on the server: OpenRouter for both the LLM (Grok) and embeddings (Gemini Embedding 2).
# There is no Ollama on the server.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
CHAT_MODEL=x-ai/grok-4.3
INTENT_MODEL=x-ai/grok-4.3
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=google/gemini-embedding-2
EMBEDDING_DIMENSIONS=768
FEASIBILITY_REWRITE=true

# Seed accounts (python -m app.scripts.seed). Passwords generated by deploy/deploy.sh when empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_TRAVELER_EMAIL=
DEMO_TRAVELER_PASSWORD=

# Reel imports (Instagram via instaloader). Make the session once on the server:
#   docker compose run --rm media-worker instaloader --login <user> --sessionfile /data/instaloader/session
INSTAGRAM_USERNAME=
INSTAGRAM_SESSION_FILE=/data/instaloader/session
# REEL_TRANSCRIBE_MODEL=google/gemini-2.5-flash

# TripJack hotels. UAT key + the server's whitelisted IPv4 (defaults are the UAT hosts).
# Production hosts need certification first:
#   TRIPJACK_SEARCH_URL=https://hms-search.tripjack.com
#   TRIPJACK_API_URL=https://tripjack.com
TRIPJACK_API_KEY=
# Our margin over TripJack's base price, in percent.
TRIPJACK_MARKUP_PERCENT=0

# TripJack flights and TripSafe insurance. Each product has its own key (portal: API Configuration);
# leave blank to reuse TRIPJACK_API_KEY. Both use apitest.tripjack.com (UAT) until certified.
TRIPJACK_FLIGHT_API_KEY=
TRIPJACK_INSURANCE_API_KEY=
# Our margin, in percent: on the flight base fare (taxes pass through) / on the insurance premium.
TRIPJACK_FLIGHT_MARKUP_PERCENT=0
TRIPJACK_INSURANCE_MARKUP_PERCENT=0
