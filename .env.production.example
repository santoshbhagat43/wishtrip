# Production settings for docker-compose.prod.yml. Copy to .env.production on the server.
# deploy/deploy.sh fills in the generated secrets on first run; OPENROUTER_API_KEY is yours to add.

# Domains (DNS A records must point at the server).
WEBSITE_DOMAIN=wishtrip.listnr.co
CREATOR_DOMAIN=creator.listnr.co
DASHBOARD_DOMAIN=wishtrip-dashboard.listnr.co
SSO_DOMAIN=sso.listnr.co
API_DOMAIN=wishtrip-api.listnr.co

ENVIRONMENT=production

# Single sign-on. One session cookie shared across every app under the parent domain, minted
# only by the SSO app. On the final domain this becomes .wishtrip.co / https://sso.wishtrip.co.
SESSION_COOKIE_DOMAIN=.listnr.co
SSO_URL=https://sso.listnr.co
POST_LOGIN_FALLBACK_URL=https://wishtrip.listnr.co/

# Google sign-in. Create an OAuth client in Google Cloud; register the redirect URI
# https://sso.listnr.co/api/sso/google/callback. The client_id is passed to the dashboard/SSO
# container; the secret stays backend-only. Until both are set, the Google button is inert.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Private preview login for the traveler website (/gate). deploy/deploy.sh generates the
# password when empty. The gate stays on in production until launch day sets SITE_PUBLIC=true.
SITE_USER=wishtrip
SITE_PASSWORD=
SITE_PUBLIC=false

# Secrets — generated by deploy/deploy.sh when empty.
POSTGRES_PASSWORD=
JWT_SECRET=

# Browsers that may call the API directly (the two apps proxy server-side, so this is for
# the API docs and future clients).
CORS_ORIGINS=["https://wishtrip.listnr.co","https://creator.listnr.co","https://wishtrip-dashboard.listnr.co","https://sso.listnr.co"]

# AI on the server: OpenRouter for both the LLM (Grok) and embeddings (Gemini Embedding 2).
# There is no Ollama on the server.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
CHAT_MODEL=x-ai/grok-4.3
INTENT_MODEL=x-ai/grok-4.3
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=google/gemini-embedding-2
EMBEDDING_DIMENSIONS=768
FEASIBILITY_REWRITE=true

# Seed accounts (python -m app.scripts.seed). Passwords generated by deploy/deploy.sh when empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_TRAVELER_EMAIL=
DEMO_TRAVELER_PASSWORD=

# Reel imports (Instagram via instaloader). Make the session once on the server:
#   docker compose run --rm media-worker instaloader --login <user> --sessionfile /data/instaloader/session
INSTAGRAM_USERNAME=
INSTAGRAM_SESSION_FILE=/data/instaloader/session
# REEL_TRANSCRIBE_MODEL=google/gemini-2.5-flash
