# Copy to .env and fill in.
JWT_SECRET=change-me-to-a-long-random-string

# Google sign-in (SSO). Create an OAuth client in Google Cloud and paste the values here.
# Authorized redirect URI (local): http://localhost:3001/api/sso/google/callback
# The client_id is also passed to the dashboard/SSO container; the secret stays backend-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM for intent + trip planning: ollama (local gemma4) | openrouter (Grok) | none | auto
# auto = openrouter when OPENROUTER_API_KEY is set, otherwise none (knowledge-base-only answers).
LLM_PROVIDER=ollama
OLLAMA_INTENT_MODEL=gemma4
OLLAMA_CHAT_MODEL=gemma4
# After the plan check changes a trip, have the planner rewrite its reply to match (one extra
# LLM call). false = append a short "plan check" note instead (faster locally).
FEASIBILITY_REWRITE=true

# OpenRouter (Grok for chat, Gemini Embedding 2 for embeddings) — used on the server.
OPENROUTER_API_KEY=
# Reel voice-over speech to text through OpenRouter (falls back to Gemini when empty).
SST_MODEL=x-ai/grok-stt-1.0
CHAT_MODEL=x-ai/grok-4.7
INTENT_MODEL=x-ai/grok-4.3
EMBEDDING_MODEL=google/gemini-embedding-2

# Embeddings provider: ollama (local, no key) | openrouter (online) | hashing | auto
# auto = openrouter when OPENROUTER_API_KEY is set, otherwise hashing.
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=embeddinggemma-2
EMBEDDING_DIMENSIONS=768

# Seed accounts (used by: docker compose exec backend python -m app.scripts.seed)
ADMIN_EMAIL=admin@wishtrip.test
ADMIN_PASSWORD=change-me
DEMO_TRAVELER_EMAIL=traveler@wishtrip.test
DEMO_TRAVELER_PASSWORD=change-me

# Reel imports (Instagram via instaloader). Make the session once on the server:
#   docker compose run --rm media-worker instaloader --login <user> --sessionfile /data/instaloader/session
INSTAGRAM_USERNAME=
INSTAGRAM_SESSION_FILE=/data/instaloader/session
# REEL_TRANSCRIBE_MODEL=google/gemini-2.5-flash

# TripJack hotels (UAT key; whitelist the server's IPv4 in the TripJack portal first).
# Production hosts: TRIPJACK_SEARCH_URL=https://hms-search.tripjack.com  TRIPJACK_API_URL=https://tripjack.com
TRIPJACK_API_KEY=
# Our margin over TripJack's base price, in percent.
TRIPJACK_MARKUP_PERCENT=0

# TripJack flights and TripSafe insurance. Each product has its own key (portal: API Configuration);
# leave blank to reuse TRIPJACK_API_KEY. Both use apitest.tripjack.com (UAT) until certified.
TRIPJACK_FLIGHT_API_KEY=
TRIPJACK_INSURANCE_API_KEY=
# Our margin, in percent: on the flight base fare (taxes pass through) / on the insurance premium.
TRIPJACK_FLIGHT_MARKUP_PERCENT=0
TRIPJACK_INSURANCE_MARKUP_PERCENT=0
