# HTTPS for all three sites; Caddy obtains and renews Let's Encrypt certificates itself.
# (No account e-mail needed; to get expiry notices, add a global block: { email you@example.com })

# The traveler website is private for now: a browser login (SITE_USER / SITE_PASSWORD in
# .env.production; Caddy only sees the bcrypt hash).
{$WEBSITE_DOMAIN} {
	encode zstd gzip
	basic_auth {
		{$SITE_USER} {$SITE_PASSWORD_HASH}
	}
	reverse_proxy website:3000
}

{$DASHBOARD_DOMAIN} {
	encode zstd gzip
	reverse_proxy dashboard:3000
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy backend:8000
}
