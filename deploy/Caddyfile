# HTTPS for all three sites; Caddy obtains and renews Let's Encrypt certificates itself.
# (No account e-mail needed; to get expiry notices, add a global block: { email you@example.com })

# The traveler website is private for now: the app's own /gate page checks SITE_USER /
# SITE_PASSWORD (not HTTP basic auth, which browsers drop whenever the app answers 401).
{$WEBSITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy website:3000
}

# The creator site is its own app (creator/): none of the website's pages answer here.
{$CREATOR_DOMAIN} {
	encode zstd gzip
	reverse_proxy creator:3000
}

{$DASHBOARD_DOMAIN} {
	encode zstd gzip
	reverse_proxy dashboard:3000
}

# Single sign-on runs from the same dashboard app (host-based); it is the login surface for
# every app, so it is deliberately NOT behind the website gate.
{$SSO_DOMAIN} {
	encode zstd gzip
	reverse_proxy dashboard:3000
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy backend:8000
}
